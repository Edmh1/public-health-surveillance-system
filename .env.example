# Copia este archivo a .env y completa los valores reales. .env nunca se commitea.

KEYCLOAK_SERVER_URL=http://keycloak:8080/
KEYCLOAK_REALM=cites
KEYCLOAK_CLIENT_ID=dashboard
# Secreto del cliente dashboard: sale del realm (campo secret del cliente en
# keycloak/cites-realm.json, o pestana Credentials del cliente en la consola).
KEYCLOAK_CLIENT_SECRET=

REDIS_URL=redis://redis:6379/0
