# Copia este archivo a .env y genera valores reales con:
#   openssl rand -hex 32
#
# .env nunca se commitea.

# Keycloak admin console
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=generar-con-openssl

# Keycloak OpenID para el dashboard
KEYCLOAK_SERVER_URL=http://keycloak:8080/
KEYCLOAK_REALM=cites
KEYCLOAK_CLIENT_ID=dashboard
KEYCLOAK_CLIENT_SECRET=generar-con-openssl
